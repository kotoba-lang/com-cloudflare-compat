  {:name ws?,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? c " ")
    1
    (if
     (string=? c "\n")
     1
     (if (string=? c "\t") 1 (if (string=? c "\r") 1 0)))),
   :param-types [:string]}
  {:name blank?,
   :params [s],
   :result :i64,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     1
     (if
      (= (ws? (string-substring s 0 1)) 1)
      (blank? (string-substring s 1 n))
      0))),
   :param-types [:string]}
  {:name trim,
   :params [s],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     s
     (if
      (= (ws? (string-substring s 0 1)) 1)
      (trim (string-substring s 1 n))
      (if
       (= (ws? (string-substring s (- n 1) n)) 1)
       (trim (string-substring s 0 (- n 1)))
       s)))),
   :param-types [:string]}
  {:name digit?,
   :params [c],
   :result :i64,
   :effects #{},
   :body (if (string-contains? "0123456789" c) 1 0),
   :param-types [:string]}
  {:name digit-val,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? c "0")
    0
    (if
     (string=? c "1")
     1
     (if
      (string=? c "2")
      2
      (if
       (string=? c "3")
       3
       (if
        (string=? c "4")
        4
        (if
         (string=? c "5")
         5
         (if
          (string=? c "6")
          6
          (if (string=? c "7") 7 (if (string=? c "8") 8 9))))))))),
   :param-types [:string]}
  {:name parse-nat,
   :params [s acc],
   :result :i64,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     acc
     (let
      [c (string-substring s 0 1)]
      (if
       (= (digit? c) 1)
       (parse-nat
        (string-substring s 1 n)
        (+ (* acc 10) (digit-val c)))
       -1)))),
   :param-types [:string :i64]}
  {:name as-int-string,
   :params [s],
   :result :i64,
   :effects #{},
   :body
   (let
    [t (trim s) n (string-byte-length t)]
    (if
     (= n 0)
     0
     (if
      (string=? (string-substring t 0 1) "-")
      (if
       (< n 2)
       0
       (let
        [v (parse-nat (string-substring t 1 n) 0)]
        (if (< v 0) 0 (- 0 v))))
      (let [v (parse-nat t 0)] (if (< v 0) 0 v))))),
   :param-types [:string]}
  {:name as-bool-string,
   :params [s],
   :result :i64,
   :effects #{},
   :body
   (let
    [t (string-fold-case s)]
    (if
     (string=? t "1")
     1
     (if
      (string=? t "true")
      1
      (if (string=? t "yes") 1 (if (string=? t "on") 1 0))))),
   :param-types [:string]}
  {:name clamp-limit,
   :params [raw],
   :result :i64,
   :effects #{},
   :body
   (let
    [base (if (< raw 1) (default-limit) raw) lo (if (< base 1) 1 base)]
    (if (< (max-limit) lo) (max-limit) lo)),
   :param-types [:i64]}
  {:name collection-path,
   :params [plural],
   :result :string,
   :effects #{},
